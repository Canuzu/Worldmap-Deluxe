he","gattung":"fuss","punkte":[[43.0886,49.6],[42.95749,49.65291],[42.74449,49.69058],[42.46193,49.68656],[42.16422,49.66449],[42.16126,49.6],[42.23274,49.54565],[42.45871,49.51143],[42.76561,49.49618],[42.94582,49.54882]],"name":"rumänische Front"},{"id":"su-nachschub","partei":"su","form":"pfeil","punkte":[[45.1,48.7],[45.048,48.696],[44.996,48.692],[44.944,48.688],[44.892,48.684],[44.84,48.68]],"name":"Nachschub über die Wolga"}]},{"zeit":"November 1942","t":75,"kurz":"Zwei Fronten aus Verbündeten.","text":"Um die 6. Armee für die Stadt freizuhalten, stehen an ihren Flanken rumänische, italienische und ungarische Verbände: schwächer bewaffnet, ohne panzerbrechende Waffen, auf einer Front von je 150 Kilometern. Genau dorthin verlegt die Rote Armee heimlich ihre Reserven.","stellungen":[{"id":"de-front","partei":"de","form":"flaeche","gattung":"fuss","punkte":[[44.67073,48.74],[44.53982,49.02324],[44.04366,49.24966],[43.3,49.20717],[42.66611,49.17444],[41.95233,49.04787],[41.9727,48.74],[42.03115,48.45013],[42.5232,48.20762],[43.3,48.27255],[44.04682,48.22817],[44.4024,48.48816]],"name":"6. Armee"},{"id":"de-stadt","partei":"de","form":"flaeche","gattung":"fuss","punkte":[[44.70018,48.70929],[44.66498,48.77971],[44.60641,48.83229],[44.53339,48.83668],[44.50444,48.76467],[44.49415,48.69018],[44.52844,48.61222],[44.5933,48.56172],[44.66197,48.57285],[44.69221,48.63759]],"name":"in der Stadt"},{"id":"de-rum-n","partei":"de","form":"flaeche","gattung":"fuss","punkte":[[43.42437,49.3],[43.25683,49.3481],[42.98464,49.38235],[42.62357,49.37869],[42.24313,49.35863],[42.23935,49.3],[42.33069,49.25059],[42.61945,49.21948],[43.01163,49.20562],[43.24192,49.25347]],"name":"3. rumänische Armee"},{"id":"de-rum-s","partei":"de","form":"flaeche","gattung":"fuss","punkte":[[44.76813,48.1],[44.5984,48.14833],[44.37266,48.18872],[44.0235,48.19069],[43.76789,48.15242],[43.65578,48.1],[43.73792,48.04395],[44.05486,48.02542],[44.39003,48.00236],[44.62332,48.04865]],"name":"4. rumänische 