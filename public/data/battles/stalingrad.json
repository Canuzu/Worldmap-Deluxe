front"},{"id":"su-sued","partei":"su","form":"flaeche","gattung":"gemischt","punkte":[[44.36526,48],[44.19771,48.10461],[43.81067,48.15619],[43.39083,48.15507],[43.12836,48.08254],[42.84231,48],[43.10511,47.91339],[43.37702,47.83469],[43.81329,47.84188],[44.103,47.91197]],"name":"Stalingrader Front"},{"id":"su-stadt","partei":"su","form":"flaeche","gattung":"fuss","punkte":[[44.82695,48.66436],[44.80238,48.73613],[44.76945,48.77878],[44.74098,48.77489],[44.72062,48.73702],[44.73246,48.65559],[44.75646,48.57992],[44.79125,48.53326],[44.8236,48.53162],[44.82965,48.5956]],"name":"62. Armee"},{"id":"su-schluss","partei":"su","form":"pfeil","punkte":[[43.3,48.86],[43.352,48.828],[43.404,48.796],[43.456,48.764],[43.508,48.732],[43.56,48.7]],"name":"Kalatsch"}]},{"zeit":"24. November 1942","t":93,"kurz":"Hitler verbietet den Ausbruch.","text":"Göring verspricht 500 Tonnen Versorgung am Tag aus der Luft – eine Zahl, die die Luftwaffe nie erreicht hat und nie erreichen wird. Tatsächlich kommen im Schnitt gut hundert Tonnen an, an manchen Tagen nichts. Der Bedarf liegt bei 700.","stellungen":[{"id":"de-kessel","partei":"de","form":"flaeche","gattung":"fuss","punkte":[[44.63351,48.68],[44.64736,48.79754],[44.4779,48.87317],[44.26354,48.89937],[44.09533,48.82486],[44.00909,48.731],[43.97704,48.62374],[44.08973,48.53153],[44.267,48.47405],[44.48468,48.47854],[44.59281,48.58205]],"name":"Kessel"},{"id":"su-nord","partei":"su","form":"flaeche","gattung":"gemischt","punkte":[[43.4275,49.2],[43.3203,49.32938],[43.0273,49.43943],[42.55914,49.45372],[42.1959,49.35022],[42.06953,49.2],[42.25429,49.0643],[42.57595,48.96398],[43.00434,48.98475],[43.41305,49.04755]],"name":"Südwestfront"},{"id":"su-sued","partei":"su","form":"flaeche","gattung":"gemischt","punkte":[[44.31496,47.98],[44.14748,48.09042],[43.76059,48.14487],[43.34091,48.14369],[43.07855,48.06713],[42.7926,47.98],[43.0553,47.88857],[43.32711,47.80551],[43.7632,47.81309],[44.05281,47.88708]],"name":"Stalingrader Front"},{"id":