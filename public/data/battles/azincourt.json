{"id":"azincourt","name":"Schlacht von Azincourt","ort":"Artois, zwischen Azincourt und Tramecourt","datum":"25. Oktober 1415","jahr":1400,"mitte":[2.137,50.463],"zoom":13.9,"grund":"relief","worum":"Ein erschöpftes, von der Ruhr geschwächtes englisches Heer schlägt eine dreifache Übermacht des französischen Adels. Entscheidend ist nicht der Langbogen allein, sondern das Gelände: ein frisch gepflügter, vom Regen grundloser Acker, der sich zwischen zwei Wäldern auf tausend Meter verengt.","parteien":[{"id":"eng","name":"England","farbe":"#c9a227","fuehrung":"Heinrich V.","staerke":"1.500 Ritter, 7.000 Bogenschützen","zahl":8500},{"id":"fra","name":"Frankreich","farbe":"#4f7fc4","fuehrung":"Charles d’Albret, Boucicaut","staerke":"geschätzt 12.000 bis 25.000","zahl":20000}],"gelaende":[{"art":"wald","punkte":[[2.12747,50.464],[2.12619,50.46831],[2.12333,50.47188],[2.119,50.47156],[2.11539,50.46976],[2.11364,50.46602],[2.11235,50.46157],[2.11545,50.45832],[2.11896,50.45615],[2.12281,50.45734],[2.12515,50.46042]],"name":"Wald von Azincourt"},{"art":"wald","punkte":[[2.16159,50.4606],[2.15969,50.464],[2.15824,50.46875],[2.15376,50.46846],[2.14997,50.46664],[2.14849,50.4626],[2.14914,50.4588],[2.14947,50.45394],[2.15369,50.45221],[2.15737,50.45451],[2.1607,50.45649]],"name":"Wald von Tramecourt"},{"art":"sumpf","punkte":[[2.14354,50.4622],[2.14271,50.46569],[2.13945,50.46824],[2.13484,50.46852],[2.1314,50.46587],[2.12955,50.4622],[2.13188,50.45883],[2.13524,50.45696],[2.13909,50.45713],[2.14281,50.45865]],"name":"gepflügter Acker"},{"art":"stadt","punkte":[[2.11853,50.459],[2.11792,50.45998],[2.116,50.46035],[2.1145,50.45977],[2.11337,50.459],[2.1143,50.45813],[2.116,50.45785],[2.11756,50.45821]],"name":"Azincourt"},{"art":"stadt","punkte":[[2.16107,50.456],[2.16034,50.45668],[2.159,50.45693],[2.15738,50.45682],[2.15672,50.456],[2.15747,50.45522],[2.159,50.45488],[2.16062,50.45518]],"name":"Tramecourt"},{"art":"stadt","punkte":[[2.13489,50.4478],[2.13461,50.44862],[2.133,5