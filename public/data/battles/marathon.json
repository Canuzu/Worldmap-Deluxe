5]]}]},{"zeit":"Umfassung","t":340,"kurz":"Der Kessel schließt sich.","text":"Die persische Mitte, eben noch siegreich, steht zwischen drei Fronten und hat keinen Raum mehr, ihre Überzahl zu entfalten. Wer in der Mitte steht, kann die Waffe nicht führen.","stellungen":[{"id":"per-linie","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.02141,38.15654],[24.02437,38.15488],[24.02802,38.15426],[24.03213,38.1544],[24.03646,38.15585],[24.03751,38.1587],[24.03816,38.16134],[24.03595,38.16336],[24.03205,38.1639],[24.02792,38.16349],[24.02432,38.16177],[24.02154,38.15934]],"name":"Eingeschlossen","geschlagen":true},{"id":"gr-mitte","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.01042,38.14883],[24.01261,38.1479],[24.01676,38.14818],[24.02171,38.14926],[24.02484,38.15136],[24.0256,38.15318],[24.0239,38.15439],[24.01936,38.1541],[24.01429,38.15275],[24.01124,38.15065]],"name":"Mitte"},{"id":"gr-rechts","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.0315,38.15887],[24.03494,38.15887],[24.03856,38.16152],[24.04176,38.165],[24.04176,38.16851],[24.04027,38.17081],[24.03703,38.17093],[24.03307,38.16899],[24.0308,38.165],[24.03027,38.16151]],"name":"Rechter Flügel"},{"id":"gr-links","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.01881,38.15326],[24.01736,38.15093],[24.02157,38.14799],[24.026,38.14571],[24.03121,38.14472],[24.03444,38.14617],[24.0335,38.1492],[24.03089,38.15222],[24.026,38.15402],[24.02106,38.15501]],"name":"Plataier"},{"id":"gr-zange-r","partei":"gr","form":"pfeil","punkte":[[24.036,38.164],[24.03524,38.16291],[24.03438,38.16192],[24.03338,38.16112],[24.03224,38.16051],[24.031,38.16]]},{"id":"gr-zange-l","partei":"gr","form":"pfeil","punkte":[[24.026,38.151],[24.02715,38.15196],[24.02817,38.15302],[24.02897,38.15422],[24.02955,38.15556],[24.03,38.157]]}]},{"zeit":"Flucht zum Sumpf","t":390,"kurz":"Der Rückweg führt ins Wasser.","text":"Was durchkommt, läuft zur Bucht. Ein Teil gerät in den Großen Sumpf im Norden, den die Fliehenden nicht kennen; dort fallen nach Herodot die meisten. Die Athener setzen bis an die Schiffe nach und nehmen sieben.","stellungen":[{"id":"per-linie","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.03356,38.16701],[24.03732,38.16565],[24.04199,38.16551],[24.04727,38.16626],[24.05271,38.16846],[24.05303,38.17135],[24.05286,38.1739],[24.0489,38.17505],[24.04348,38.17428],[24.03844,38.17258],[24.03521,38.16996]],"name":"Flucht","geschlagen":true},{"id":"gr-mitte","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.01402,38.15257],[24.01701,38.15131],[24.02269,38.1516],[24.02969,38.15266],[24.03517,38.15557],[24.03799,38.1583],[24.03803,38.16067],[24.03304,38.16124],[24.0261,38.16044],[24.01957,38.15778],[24.01529,38.15505]],"name":"Athener"},{"id":"gr-rechts","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.03458,38.16092],[24.03789,38.16038],[24.04185,38.16232],[24.04556,38.16511],[24.04618,38.16842],[24.04514,38.17082],[24.04204,38.17143],[24.03788,38.17022],[24.03498,38.16681],[24.03385,38.1636]],"name":"Rechter Flügel"},{"id":"per-flucht","partei":"per","form":"pfeil","punkte":[[24.034,38.161],[24.03867,38.16433],[24.04354,38.16707],[24.04874,38.16887],[24.05427,38.16973],[24.06,38.17]],"name":"zu den Schiffen","rueckzug":true},{"id":"per-sumpf","partei":"per","form":"pfeil","punkte":[[24.036,38.164],[24.03882,38.16621],[24.04133,38.16865],[24.04333,38.17145],[24.04482,38.17461],[24.046,38.178]],"name":"in den Sumpf","rueckzug":true}]},{"zeit":"Am Strand","t":430,"kurz":"Kynegeiros verliert die Hand.","text":"Am Ufer wird um die Schiffe gekämpft. Kynegeiros, der Bruder des Dichters Aischylos, packt ein ablegendes Schiff am Heck und wird mit einem Beilhieb getötet – die eine Szene, die aus dieser Schlacht in jedes Schulbuch gelangt ist.","stellungen":[{"id":"per-linie","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.04672,38.16935],[24.05017,38.16789],[24.05439,38.16763],[24.05912,38.16822],[24.06393,38.17024],[24.06409,38.17308],[24.06381,38.1756],[24.06019,38.17685],[24.05533,38.17624],[24.05087,38.17471],[24.04808,38.1722]],"name":"Rückzug an Bord","geschlagen":true},{"id":"gr-mitte","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.03102,38.16286],[24.03393,38.16134],[24.03924,38.16137],[24.04574,38.16218],[24.05065,38.16508],[24.05308,38.16792],[24.05293,38.17049],[24.0482,38.17135],[24.04174,38.17082],[24.03581,38.16825],[24.03201,38.16549]],"name":"Athener"},{"id":"gr-strand","partei":"gr","form":"pfeil","punkte":[[24.044,38.166],[24.0468,38.1672],[24.0496,38.1684],[24.0524,38.1696],[24.0552,38.1708],[24.058,38.172]],"name":"Kampf um die Schiffe"}]},{"zeit":"Der Eilmarsch","t":500,"kurz":"Vierzig Kilometer noch am selben Tag.","text":"Die persische Flotte hält auf Athen zu, das jetzt ohne Heer ist. Die Athener marschieren noch am selben Tag zurück und stehen am Abend vor der Stadt. Als die Flotte am nächsten Morgen vor Phaleron erscheint, sieht sie das Heer am Ufer stehen – und dreht ab.","stellungen":[{"id":"gr-mitte","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[23.98253,38.13506],[23.98622,38.13373],[23.99282,38.13445],[24.00085,38.1362],[24.00679,38.14009],[24.00966,38.14358],[24.00934,38.14645],[24.00342,38.1468],[23.99541,38.14537],[23.98819,38.14173],[23.98362,38.13814]],"name":"Rückmarsch nach Athen"},{"id":"gr-marsch","partei":"gr","form":"pfeil","punkte":[[24,38.142],[23.99122,38.13445],[23.98198,38.1278],[23.97198,38.1226],[23.96122,38.11885],[23.95,38.116]],"name":"nach Athen"},{"id":"per-abzug","partei":"per","form":"pfeil","punkte":[[24.066,38.176],[24.07233,38.17221],[24.07807,38.16788],[24.08287,38.16268],[24.08673,38.15661],[24.09,38.15]],"name":"Flotte um Kap Sunion","rueckzug":true}]}],"ausgang":"Die Perser verlieren nach Herodot 6.400 Mann, die Athener 192 – eine Zahl, die die Stadt später auf einem Grabhügel im Feld verewigt, der heute noch steht. Der Feldzug ist gescheitert, ohne dass er Athen auch nur erreicht hätte.","verluste":[{"partei":"per","text":"6.400 Gefallene, 7 Schiffe verloren (Angabe Herodots)"},{"partei":"gr","text":"192 Athener und eine unbekannte Zahl Plataier"}],"folgen":"Athen erfährt, dass Bürger im Schlachtfeld etwas taugen – die Selbstgewissheit, aus der ein Menschenalter später die Demokratie des Perikles wächst. Zehn Jahre danach kommt Xerxes mit einem ungleich größeren Heer wieder.","streit":"Herodots Zahlen für die persische Seite gelten in der Forschung als zu hoch gegriffen; verlässlich ist nur die Größenordnung einer deutlichen Überlegenheit. Auch der genaue Ort der Aufstellung wird bis heute diskutiert."}