 durch.","text":"An beiden Enden sind die Athener stärker – und die persischen Flügel bestehen aus leichter gerüsteten Verbänden. Sie brechen und laufen. Die Frage ist jetzt, ob die siegreichen Flügel nachsetzen oder umkehren.","stellungen":[{"id":"per-linie","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.0154,38.15439],[24.01955,38.15239],[24.02476,38.15176],[24.03071,38.15215],[24.03708,38.15424],[24.03882,38.15797],[24.03997,38.16142],[24.03694,38.16394],[24.03135,38.16445],[24.02535,38.16371],[24.02002,38.16131],[24.01581,38.15803]],"name":"Persische Mitte"},{"id":"per-fl-n","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.0396,38.16817],[24.04186,38.16623],[24.04641,38.16644],[24.05026,38.16814],[24.0527,38.17059],[24.05181,38.17304],[24.04785,38.1738],[24.04347,38.17286],[24.04029,38.17073]],"name":"Rechter Flügel","geschlagen":true},{"id":"per-fl-s","partei":"per","form":"flaeche","gattung":"fuss","punkte":[[24.00723,38.14806],[24.01049,38.1468],[24.01441,38.14643],[24.0185,38.14803],[24.0208,38.1506],[24.01975,38.15301],[24.01584,38.15378],[24.0112,38.15316],[24.00822,38.15074]],"name":"Linker Flügel","geschlagen":true},{"id":"gr-mitte","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[23.99892,38.14197],[24.00091,38.14124],[24.00474,38.14159],[24.00934,38.14262],[24.01232,38.14447],[24.01309,38.14603],[24.01157,38.14702],[24.00738,38.14665],[24.00265,38.14538],[23.99976,38.14353]],"name":"Mitte","geschlagen":true},{"id":"gr-rechts","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.03731,38.16018],[24.04062,38.16049],[24.0434,38.16316],[24.04555,38.16652],[24.04461,38.16962],[24.04255,38.17152],[24.0394,38.17133],[24.03611,38.16926],[24.03499,38.16553],[24.03541,38.1624]],"name":"Rechter Flügel"},{"id":"gr-links","partei":"gr","form":"flaeche","gattung":"fuss","punkte":[[24.00318,38.14795],[24.00223,38.14546],[24.00638,38.14333],[24.01063,38.14187],[24.01537,38.14177],[24.01801,38.14371],[24.01674,38.14647],