{"id":"marathon","name":"Schlacht bei Marathon","ort":"Ebene von Marathon, Attika","datum":"12. September 490 v. Chr.","jahr":-500,"mitte":[24.018,38.15],"zoom":12.9,"grund":"relief","worum":"Der erste Perserzug gegen Griechenland. Ein athenisches Bürgerheer greift ein weit überlegenes Landungsheer im Sturmschritt an, hält die Mitte bewusst dünn und umfasst beide Flügel – die erste Umfassungsschlacht, von der wir eine Beschreibung haben.","parteien":[{"id":"gr","name":"Athener und Plataier","farbe":"#6f9fe0","fuehrung":"Miltiades, Kallimachos","staerke":"9.000 Athener, 1.000 Plataier","zahl":10000},{"id":"per","name":"Perser und Verbündete","farbe":"#d4737c","fuehrung":"Datis und Artaphernes","staerke":"20.000 bis 25.000","zahl":24000}],"gelaende":[{"art":"sumpf","punkte":[[24.06883,38.18653],[24.06591,38.1926],[24.05342,38.19289],[24.04098,38.19084],[24.03129,38.18556],[24.02154,38.17961],[24.0244,38.17382],[24.02498,38.1667],[24.03925,38.16827],[24.05194,38.16716],[24.05989,38.17475],[24.06862,38.18036]],"name":"Großer Sumpf"},{"art":"hoehe","punkte":[[23.99051,38.13532],[23.98144,38.13803],[23.97119,38.13809],[23.96073,38.13405],[23.9548,38.12759],[23.95376,38.12162],[23.9553,38.11592],[23.96349,38.1136],[23.97464,38.11466],[23.98296,38.12112],[23.99155,38.12802]],"name":"Agrieliki"},{"art":"hoehe","punkte":[[24.0174,38.20007],[24.01143,38.19996],[24.00473,38.19675],[23.99743,38.19027],[23.99895,38.18359],[24.00078,38.17744],[24.00815,38.17715],[24.01583,38.18254],[24.02002,38.18979],[24.0234,38.19778]],"name":"Kotroni"},{"art":"fluss","punkte":[[23.982,38.166],[24.004,38.157],[24.028,38.151],[24.054,38.147]],"name":"Charadra"},{"art":"stadt","punkte":[[23.96443,38.153],[23.96433,38.15447],[23.962,38.15463],[23.95965,38.15448],[23.95873,38.153],[23.96013,38.15182],[23.962,38.15119],[23.96396,38.15177]],"name":"Marathon"},{"art":"wald","punkte":[[23.99705,38.13545],[23.99542,38.13737],[23.99141,38.13814],[23.98777,38.13604],[23.98655,38.13361],[23.98663,38.13106],