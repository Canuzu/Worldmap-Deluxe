          ]
        },
        {
          "zeit": "21:00 Uhr",
          "text": "Wellington lässt die ganze Linie vorgehen, Blücher stößt in die Flanke. Das französische Heer löst sich auf. Vier Tage später dankt Napoleon zum zweiten Mal ab.",
          "stellungen": [
            { "partei": "koa", "form": "flaeche", "punkte": [[4.35, 50.692], [4.47, 50.692], [4.47, 50.662], [4.35, 50.662]] },
            { "partei": "pru", "form": "flaeche", "punkte": [[4.430, 50.672], [4.515, 50.672], [4.515, 50.648], [4.430, 50.648]] },
            { "partei": "fra", "form": "pfeil", "punkte": [[4.410, 50.660], [4.380, 50.640]], "text": "Auflösung" }
