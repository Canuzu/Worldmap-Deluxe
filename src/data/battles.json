      ],
      "stationen": [
        {
          "zeit": "11:30 Uhr",
          "text": "Wellington steht auf dem Höhenzug von Mont-Saint-Jean, die Masse seiner Truppen hinter dem Kamm verborgen. Napoleon eröffnet mit einem Ablenkungsangriff auf das Gehöft Hougoumont.",
          "stellungen": [
