            { "partei": "fra", "form": "pfeil", "punkte": [[4.405, 50.672], [4.408, 50.682]], "text": "Neys Reiterei" },
            { "partei": "pru", "form": "pfeil", "punkte": [[4.520, 50.660], [4.462, 50.664]], "text": "Blücher rückt an" }
          ]
        },
        {
          "zeit": "18:30 Uhr",
          "text": "La Haye Sainte fällt endlich, Wellingtons Mitte steht offen. Doch Napoleon hat keine Reserve mehr frei: Ein Teil der Garde bindet die Preußen in Plancenoit.",
          "stellungen": [
            { "partei": "koa", "form": "flaeche", "punkte": [[4.36, 50.690], [4.46, 50.690], [4.46, 50.682], [4.36, 50.682]] },
            { "partei": "fra", "form": "flaeche", "punkte": [[4.35, 50.680], [4.47, 50.680], [4.47, 50.655], [4.35, 50.655]] },
            { "partei": "pru", "form": "flaeche", "punkte": [[4.462, 50.668], [4.510, 50.668], [4.510, 50.652], [4.462, 50.652]] }
          ]
        },
        {
          "zeit": "19:30 Uhr",
          "text": "Napoleon setzt die Kaisergarde an – zum ersten Mal wird sie geworfen. Der Ruf „La Garde recule“ bricht die französische Front.",
          "stellungen": [
            { "partei": "koa", "form": "flaeche", "punkte": [[4.36, 50.690], [4.46, 50.690], [4.46, 50.681], [4.36, 50.681]] },
            { "partei": "fra", "form": "flaeche", "punkte": [[4.36, 50.679], [4.46, 50.679], [4.46, 50.658], [4.36, 50.658]] },
            { "partei": "fra", "form": "pfeil", "punkte": [[4.405, 50.673], [4.412, 50.683]], "text": "Kaisergarde" },
