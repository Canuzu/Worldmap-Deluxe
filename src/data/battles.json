        { "id": "per", "name": "Perser und Verbündete", "farbe": "#d4737c", "fuehrung": "Dareios III.", "staerke": "ca. 100.000" }
      ],
      "stationen": [
        {
          "zeit": "Morgen",
          "text": "Dareios hat die Ebene einebnen lassen, damit seine Sichelwagen freie Bahn haben. Seine Linie ist doppelt so breit wie die makedonische und droht, sie an beiden Flügeln zu umfassen.",
          "stellungen": [
            { "partei": "per", "form": "flaeche", "punkte": [[43.48, 36.46], [43.74, 36.46], [43.74, 36.41], [43.48, 36.41]] },
            { "partei": "mak", "form": "flaeche", "punkte": [[43.55, 36.36], [43.70, 36.36], [43.70, 36.32], [43.55, 36.32]] }
          ]
        },
        {
          "zeit": "Erste Phase",
          "text": "Alexander lässt sein Heer schräg nach rechts marschieren. Dareios muss folgen, sonst verliert er den eingeebneten Boden – und beim Nachziehen reißt seine Linie auf.",
          "stellungen": [
            { "partei": "per", "form": "flaeche", "punkte": [[43.52, 36.46], [43.78, 36.46], [43.78, 36.41], [43.52, 36.41]] },
            { "partei": "mak", "form": "flaeche", "punkte": [[43.60, 36.37], [43.76, 36.37], [43.76, 36.33], [43.60, 36.33]] },
            { "partei": "mak", "form": "pfeil", "punkte": [[43.62, 36.35], [43.78, 36.38]], "text": "Rechtsschub" }
          ]
        },
        {
          "zeit": "Zweite Phase",
          "text": "Die Sichelwagen rollen an. Die Makedonen öffnen Gassen, lassen sie durchfahren und fangen sie im Rücken ab. Zugleich reitet die persische Kavallerie an beiden Flügeln zum Angriff.",
          "stellungen": [
            { "partei": "per", "form": "flaeche", "punkte": [[43.52, 36.46], [43.78, 36.46], [43.78, 36.40], [43.52, 36.40]] },
            { "partei": "mak", "form": "flaeche", "punkte": [[43.60, 36.37], [43.76, 36.37], [43.76, 36.33], [43.60, 36.33]] },
            { "partei": "per", "form": "pfeil", "punkte": [[43.55, 36.44], [43.60, 36.37]], "text": "Bessos" },
            { "partei": "per", "form": "pfeil", "punkte": [[43.76, 36.44], [43.78, 36.36]], "text": "Mazaios" }
          ]
        },
        {
          "zeit": "Entscheidung",
          "text": "Im Nachziehen klafft links der persischen Mitte eine Lücke. Alexander führt die Hetairenreiterei im Keil hinein – geradewegs auf Dareios zu.",
          "stellungen": [
            { "partei": "per", "form": "flaeche", "punkte": [[43.52, 36.46], [43.62, 36.46], [43.62, 36.40], [43.52, 36.40]] },
            { "partei": "per", "form": "flaeche", "punkte": [[43.68, 36.46], [43.78, 36.46], [43.78, 36.40], [43.68, 36.40]] },
            { "partei": "mak", "form": "flaeche", "punkte": [[43.58, 36.37], [43.74, 36.37], [43.74, 36.33], [43.58, 36.33]] },
            { "partei": "mak", "form": "pfeil", "punkte": [[43.70, 36.36], [43.64, 36.45]], "text": "Hetairen" }
          ]
        },
        {
          "zeit": "Ausgang",
          "text": "Dareios flieht, sein Heer zerfällt. Der linke makedonische Flügel unter Parmenion war da noch schwer bedrängt – Alexander bricht die Verfolgung ab und wendet, um ihn zu entsetzen.",
          "stellungen": [
            { "partei": "mak", "form": "flaeche", "punkte": [[43.50, 36.47], [43.80, 36.47], [43.80, 36.32], [43.50, 36.32]] },
            { "partei": "per", "form": "pfeil", "punkte": [[43.62, 36.45], [43.48, 36.50]], "text": "Flucht des Dareios" }
          ]
        }
      ]
    },

    {
      "id": "hastings",
      "name": "Schlacht bei Hastings",
      "ort": "Senlac Hill, Sussex",
      "datum": "14. Oktober 1066",
      "jahr": 1100,
      "mitte": [0.487, 50.913],
      "zoom": 13.5,
      "worum": "Wilhelm von der Normandie gegen Harold Godwinson. Ein Tag entscheidet, wer England regiert – und beendet die angelsächsische Herrschaft endgültig.",
      "parteien": [
        { "id": "eng", "name": "Angelsachsen", "farbe": "#c9a227", "fuehrung": "Harold Godwinson", "staerke": "ca. 7.000" },
        { "id": "nor", "name": "Normannen", "farbe": "#6f9fe0", "fuehrung": "Wilhelm der Eroberer", "staerke": "ca. 8.000" }
      ],
      "stationen": [
        {
          "zeit": "9 Uhr",
          "text": "Harold stellt seinen Schildwall auf dem Höhenrücken von Senlac auf. Der Hang zwingt die Normannen, jeden Angriff bergauf zu führen.",
          "stellungen": [
            { "partei": "eng", "form": "flaeche", "punkte": [[0.480, 50.9165], [0.494, 50.9165], [0.494, 50.9145], [0.480, 50.9145]] },
            { "partei": "nor", "form": "flaeche", "punkte": [[0.478, 50.9105], [0.496, 50.9105], [0.496, 50.9085], [0.478, 50.9085]] }
          ]
        },
        {
          "zeit": "Vormittag",
          "text": "Normannische Bogenschützen und Fußvolk laufen den Hang hinauf. Der Schildwall hält; die Angreifer weichen zurück.",
          "stellungen": [
            { "partei": "eng", "form": "flaeche", "punkte": [[0.480, 50.9165], [0.494, 50.9165], [0.494, 50.9145], [0.480, 50.9145]] },
            { "partei": "nor", "form": "flaeche", "punkte": [[0.478, 50.9115], [0.496, 50.9115], [0.496, 50.9090], [0.478, 50.9090]] },
            { "partei": "nor", "form": "pfeil", "punkte": [[0.487, 50.9110], [0.487, 50.9142]], "text": "Sturm bergauf" }
          ]
        },
        {
          "zeit": "Mittag",
          "text": "Auf dem linken Flügel gerät das bretonische Kontingent ins Weichen. Ein Teil der Angelsachsen bricht aus dem Schildwall aus, um nachzusetzen – und steht plötzlich ohne Deckung im offenen Feld.",
          "stellungen": [
            { "partei": "eng", "form": "flaeche", "punkte": [[0.482, 50.9165], [0.494, 50.9165], [0.494, 50.9145], [0.482, 50.9145]] },
            { "partei": "eng", "form": "pfeil", "punkte": [[0.483, 50.9146], [0.478, 50.9118]], "text": "Ausbruch" },
            { "partei": "nor", "form": "flaeche", "punkte": [[0.484, 50.9118], [0.496, 50.9118], [0.496, 50.9092], [0.484, 50.9092]] }
          ]
        },
        {
          "zeit": "Nachmittag",
          "text": "Wilhelm lässt die Bewegung wiederholen – nun planmäßig. Zweimal weicht die Reiterei zurück, zweimal folgen Angelsachsen, zweimal wenden die Normannen und reiben die Verfolger auf. Der Schildwall dünnt aus.",
          "stellungen": [
            { "partei": "eng", "form": "flaeche", "punkte": [[0.483, 50.9163], [0.492, 50.9163], [0.492, 50.9147], [0.483, 50.9147]] },
            { "partei": "nor", "form": "flaeche", "punkte": [[0.478, 50.9140], [0.498, 50.9140], [0.498, 50.9100], [0.478, 50.9100]] },
            { "partei": "nor", "form": "pfeil", "punkte": [[0.480, 50.9112], [0.484, 50.9145]], "text": "Scheinflucht und Kehre" },
            { "partei": "nor", "form": "pfeil", "punkte": [[0.495, 50.9112], [0.491, 50.9145]] }
          ]
        },
        {
          "zeit": "Abend",
          "text": "Harold fällt. Ohne König löst sich der Schildwall auf; die Normannen nehmen den Höhenrücken. England hat einen neuen Herrscher.",
          "stellungen": [
            { "partei": "nor", "form": "flaeche", "punkte": [[0.477, 50.9170], [0.499, 50.9170], [0.499, 50.9085], [0.477, 50.9085]] },
            { "partei": "eng", "form": "pfeil", "punkte": [[0.489, 50.9158], [0.496, 50.9178]], "text": "Rest flieht" }
          ]
        }
      ]
    },

    {
