      ],
      "stationen": [
        {
          "zeit": "23. August 1942",
          "text": "Das XIV. Panzerkorps erreicht nördlich der Stadt die Wolga. Am selben Tag legt die Luftwaffe Stalingrad in Trümmer – die Ruinen werden für den Verteidiger zum Vorteil.",
          "stellungen": [
            { "partei": "de", "form": "flaeche", "punkte": [[42.0, 49.6], [44.5, 49.0], [44.6, 48.4], [43.8, 48.0], [42.0, 48.2]] },
            { "partei": "su", "form": "flaeche", "punkte": [[44.55, 48.85], [44.85, 48.85], [44.85, 48.45], [44.55, 48.45]] },
            { "partei": "de", "form": "pfeil", "punkte": [[43.4, 48.9], [44.5, 48.78]], "text": "Vorstoß zur Wolga" }
          ]
        },
        {
          "zeit": "Oktober 1942",
          "text": "Der Kampf verdichtet sich auf Fabrikhallen und Treppenhäuser. Tschuikow hält die Frontlinie bewusst wenige Dutzend Meter vom Gegner entfernt, damit die deutsche Artillerie nicht schießen kann. Den Sowjets bleibt nur ein schmaler Uferstreifen.",
          "stellungen": [
            { "partei": "de", "form": "flaeche", "punkte": [[42.0, 49.6], [44.7, 49.0], [44.75, 48.4], [43.8, 48.0], [42.0, 48.2]] },
            { "partei": "su", "form": "flaeche", "punkte": [[44.72, 48.80], [44.90, 48.80], [44.90, 48.55], [44.72, 48.55]] },
            { "partei": "su", "form": "pfeil", "punkte": [[45.10, 48.70], [44.85, 48.70]], "text": "Nachschub über die Wolga" }
          ]
        },
        {
          "zeit": "19. November 1942",
          "text": "Operation Uranus. Die Rote Armee greift nicht die Stadt an, sondern die schwach besetzten rumänischen Flanken weit nördlich und südlich davon.",
          "stellungen": [
            { "partei": "de", "form": "flaeche", "punkte": [[42.0, 49.6], [44.7, 49.0], [44.75, 48.4], [43.8, 48.0], [42.0, 48.2]] },
            { "partei": "su", "form": "pfeil", "punkte": [[43.0, 49.6], [43.6, 48.7]], "text": "Nordzange" },
            { "partei": "su", "form": "pfeil", "punkte": [[44.4, 47.9], [43.8, 48.6]], "text": "Südzange" }
          ]
        },
        {
          "zeit": "23. November 1942",
          "text": "Die Zangen schließen sich bei Kalatsch. Rund 270.000 Mann sind eingeschlossen. Hitler verbietet den Ausbruch; Göring verspricht Versorgung aus der Luft, die nie annähernd ausreicht.",
          "stellungen": [
            { "partei": "de", "form": "flaeche", "punkte": [[43.6, 48.95], [44.75, 48.90], [44.80, 48.50], [43.9, 48.45], [43.6, 48.65]] },
            { "partei": "su", "form": "flaeche", "punkte": [[41.8, 49.9], [43.5, 49.6], [43.4, 48.2], [41.8, 47.9]] },
            { "partei": "su", "form": "pfeil", "punkte": [[43.5, 49.2], [43.55, 48.75]] },
            { "partei": "su", "form": "pfeil", "punkte": [[43.4, 48.3], [43.85, 48.5]] }
          ]
        },
        {
          "zeit": "Dezember 1942",
          "text": "Der Entsatzangriff „Wintergewitter“ kommt auf 48 Kilometer heran und bleibt liegen. Der Kessel schrumpft, die Eingeschlossenen hungern und frieren.",
          "stellungen": [
            { "partei": "de", "form": "flaeche", "punkte": [[43.75, 48.90], [44.72, 48.86], [44.76, 48.55], [44.0, 48.52], [43.75, 48.70]] },
            { "partei": "de", "form": "pfeil", "punkte": [[43.2, 47.9], [43.9, 48.45]], "text": "Wintergewitter" },
            { "partei": "su", "form": "flaeche", "punkte": [[41.8, 49.9], [43.6, 49.6], [43.5, 48.1], [41.8, 47.9]] }
          ]
        },
        {
          "zeit": "2. Februar 1943",
          "text": "Die letzten Verbände kapitulieren. Von rund 110.000 Gefangenen kehren etwa 6.000 zurück. Von Stalingrad an führt die Ostfront nur noch in eine Richtung.",
          "stellungen": [
            { "partei": "su", "form": "flaeche", "punkte": [[41.5, 50.1], [45.1, 49.6], [45.1, 47.8], [41.5, 47.6]] },
            { "partei": "su", "form": "pfeil", "punkte": [[44.2, 48.7], [42.5, 49.0]], "text": "Vorstoß nach Westen" }
